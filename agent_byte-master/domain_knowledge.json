          "role": "Technical analysis and momentum strategy specialist",
          "strengths": ["price momentum", "trend following", "moving averages", "RSI/MACD", "breakout detection"],
          "best_for": ["momentum signals", "trend analysis", "technical analysis", "entry/exit timing"],
          "avoid_for": ["risk sizing", "fundamental analysis"]
        },
        "RiskGuardian": {
