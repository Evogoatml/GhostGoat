  "routing_rules": [
    {
      "if_keywords_match": ["debug", "error", "traceback", "exception", "crash", "broken", "failing"],
      "prefer_agent": "DebugMaster",
      "prefer_domain": "coding"
    },
    {
      "if_keywords_match": ["security", "vulnerability", "exploit", "injection", "xss", "csrf", "cve", "audit"],
      "prefer_agent": "SecurityAuditor",
      "prefer_domain": "coding"
    },
    {
      "if_keywords_match": ["slow", "performance", "optimise", "optimize", "fast", "latency", "bottleneck"],
      "prefer_agent": "PerformanceOptimizer",
      "prefer_domain": "coding"
    },
    {
      "if_keywords_match": ["predict", "forecast", "model", "ml", "machine learning", "train", "classifier"],
      "prefer_agent": "PredictiveModeler",
      "prefer_domain": "analysis"
    },
    {
      "if_keywords_match": ["anomaly", "outlier", "unusual", "abnormal", "flag", "detect"],
      "prefer_agent": "AnomalyDetector",
      "prefer_domain": "analysis"
    },
    {
      "if_keywords_match": ["why", "root cause", "what caused", "incident", "post-mortem"],
      "prefer_agent": "RootCauseFinder",
      "prefer_domain": "analysis"
    },
    {
      "if_keywords_match": ["blockchain", "on-chain", "defi", "wallet", "crypto fundamentals"],
      "prefer_agent": "OnChainSentry",
      "prefer_domain": "trading"
    },
    {
      "if_keywords_match": ["risk", "position size", "stop loss", "drawdown", "portfolio risk"],
      "prefer_agent": "RiskGuardian",
      "prefer_domain": "trading"
    },
    {
      "if_keywords_match": ["validate", "fact-check", "credible", "reliable source", "is this true"],
      "prefer_agent": "SourceValidator",
      "prefer_domain": "research"
    },
    {
      "if_keywords_match": ["plan", "roadmap", "timeline", "schedule", "how to achieve", "steps to"],
      "prefer_agent": "GoalDecomposer",
      "prefer_domain": "planning"
    },
    {
      "if_keywords_match": ["write", "story", "narrative", "blog", "article", "essay"],
      "prefer_agent": "StoryWeaver",
      "prefer_domain": "creative"
    },
    {
      "if_keywords_match": ["edit", "proofread", "improve draft", "clearer", "polish"],
      "prefer_agent": "QualityPolisher",
      "prefer_domain": "creative"
    }
  ]
}
