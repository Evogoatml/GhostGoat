          "best_for": ["on-chain data", "blockchain metrics", "DeFi analysis", "crypto fundamentals", "wallet flows"],
          "avoid_for": ["traditional equity analysis", "technical charting"]
        },
        "RegimeSensor": {
          "role": "Market regime classification and macro analyst",
          "strengths": ["regime detection", "macro analysis", "VIX interpretation", "credit spreads", "cross-asset correlation"],
          "best_for": ["market regime", "macro environment", "risk-on/risk-off", "what regime are we in", "macro trends"],
          "avoid_for": ["individual security analysis", "execution"]
        },
        "ExecutionOptimizer": {
          "role": "Trade execution and order flow optimisation",
          "strengths": ["TWAP/VWAP", "slippage reduction", "market impact", "limit vs market orders", "execution timing"],
          "best_for": ["how to execute this trade", "reduce slippage", "optimal order type", "execution strategy"],
          "avoid_for": ["strategy generation", "risk assessment"]
        }
