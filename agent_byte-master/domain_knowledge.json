        "correlation", "distribution", "statistics", "metric", "KPI", "dashboard",
        "report", "insight", "visualise", "visualize", "chart", "plot"
      ],
      "agents": {
        "DataAnalyzer": {
          "role": "Exploratory data analysis and statistical insight specialist",
          "strengths": ["EDA", "descriptive statistics", "data cleaning", "visualisation", "feature engineering"],
          "best_for": ["analyse this data", "explore this dataset", "what do these numbers mean", "data insights"],
          "avoid_for": ["predictive modelling", "root cause analysis"]
        },
        "TrendSpotter": {
