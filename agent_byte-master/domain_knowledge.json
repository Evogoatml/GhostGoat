      "tools": ["fetch_ohlcv", "get_onchain_metrics", "news_sentiment_api", "option_chain_api"],
      "common_metrics": ["sharpe_ratio", "sortino_ratio", "max_drawdown", "win_rate", "profit_factor", "calmar_ratio"],
      "best_practices": [
        "Never risk more than 1-2% of portfolio on a single trade",
        "Define exit before entry — know your stop loss and target before placing the order",
        "Backtest strategies on out-of-sample data before going live",
        "Beware of survivorship bias in historical data",
        "Correlation between assets increases during crashes — diversification breaks when you need it most",
        "Track slippage and execution costs — they compound against you over time"
      ]
    },
    "analysis": {
      "description": "Exploratory data analysis, anomaly detection, root cause analysis, trend identification, and predictive modelling.",
      "trigger_keywords": [
        "analyse", "analyze", "data", "dataset", "anomaly", "outlier", "trend",
