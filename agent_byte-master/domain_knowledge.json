          "avoid_for": ["predictive modelling", "exploratory analysis"]
        },
        "PredictiveModeler": {
          "role": "Machine learning and statistical forecasting",
          "strengths": ["regression", "classification", "time-series forecasting", "model evaluation", "uncertainty quantification"],
          "best_for": ["predict", "forecast", "what will happen", "model this", "estimate future", "classify this"],
          "avoid_for": ["exploratory analysis", "root cause investigation"]
        }
      },
