{
  "version": "1.0",
  "description": "GhostGoat domain knowledge — agent profiles, capabilities, tools, and routing hints used by the orchestrator to assign tasks to the right specialists.",
  "domains": {
    "coding": {
      "description": "Software development, debugging, refactoring, security auditing, performance engineering, and system architecture.",
      "trigger_keywords": [
        "code", "function", "class", "debug", "error", "bug", "fix", "implement",
        "refactor", "optimise", "optimize", "api", "endpoint", "database", "schema",
        "test", "unit test", "security", "vulnerability", "audit", "architecture",
        "deploy", "docker", "kubernetes", "ci/cd", "pipeline", "performance", "slow",
        "python", "javascript", "typescript", "java", "go", "rust", "c++", "sql"
      ],
      "agents": {
        "CodeArchitect": {
          "role": "Senior software architect and implementer",
          "strengths": ["system design", "API design", "database schemas", "new feature implementation", "architectural decisions"],
          "best_for": ["design a system", "implement a feature", "create an API", "set up a database", "build from scratch"],
          "avoid_for": ["debugging existing bugs", "security audits"]
        },
        "DebugMaster": {
          "role": "Expert debugger and error analyst",
          "strengths": ["traceback analysis", "runtime errors", "logic bugs", "intermittent failures", "memory leaks"],
          "best_for": ["fix this error", "debug this crash", "why is this failing", "traceback", "exception"],
          "avoid_for": ["new implementations", "architecture design"]
        },
        "RefactorExpert": {
          "role": "Code quality and technical debt specialist",
          "strengths": ["code cleanup", "design patterns", "dependency reduction", "readability improvement", "DRY principles"],
          "best_for": ["refactor this code", "clean up", "improve code quality", "reduce duplication", "make readable"],
          "avoid_for": ["new features", "debugging"]
        },
        "SecurityAuditor": {
          "role": "Application security and vulnerability analyst",
          "strengths": ["OWASP top 10", "code injection", "authentication flaws", "secrets scanning", "dependency vulnerabilities"],
          "best_for": ["security review", "vulnerability scan", "check for security issues", "penetration test prep", "audit code"],
          "avoid_for": ["performance optimisation", "new features"]
        },
        "PerformanceOptimizer": {
          "role": "Performance profiling and optimisation engineer",
          "strengths": ["profiling", "algorithmic complexity", "caching", "async patterns", "database query optimisation"],
          "best_for": ["slow code", "optimise performance", "reduce latency", "improve throughput", "profile this"],
          "avoid_for": ["security audits", "code architecture"]
        }
      },
      "tools": ["python", "pytest", "black", "mypy", "bandit", "cProfile", "pdb", "docker", "git"],
      "common_metrics": ["test_coverage", "cyclomatic_complexity", "lines_of_code", "error_rate", "latency_p99"],
      "best_practices": [
        "Write tests before or alongside implementation",
        "Every function has a single responsibility",
        "Fail fast with explicit error messages",
        "Never hardcode secrets — use environment variables",
        "Profile before optimising",
        "Document the why, not the what"
      ]
    },
    "research": {
      "description": "Information gathering, source validation, pattern recognition, synthesis, and citation tracking across academic, news, and primary sources.",
      "trigger_keywords": [
        "research", "find", "search", "gather", "collect", "investigate", "explore",
        "study", "analyse", "survey", "review", "literature", "papers", "articles",
        "sources", "validate", "fact-check", "summarise", "synthesise", "compare",
        "what is", "how does", "explain", "overview", "background"
      ],
      "agents": {
        "DataGatherer": {
          "role": "Multi-source information retrieval specialist",
          "strengths": ["web search", "academic databases", "primary source retrieval", "structured data extraction"],
          "best_for": ["find information about", "gather data on", "research topic", "collect sources"],
          "avoid_for": ["synthesis", "validation of gathered material"]
        },
        "PatternFinder": {
          "role": "Statistical pattern recognition and correlation analyst",
          "strengths": ["trend detection", "correlation analysis", "clustering", "anomaly identification in research data"],
          "best_for": ["identify patterns in", "find trends across", "what patterns exist in", "correlate these findings"],
          "avoid_for": ["source retrieval", "citation management"]
        },
        "SourceValidator": {
          "role": "Source credibility and fact-checking specialist",
          "strengths": ["credibility assessment", "cross-referencing", "bias detection", "misinformation identification"],
          "best_for": ["validate this source", "is this reliable", "fact-check", "verify this claim"],
          "avoid_for": ["data gathering", "synthesis writing"]
        },
        "SynthesisEngine": {
          "role": "Multi-source synthesis and narrative construction",
          "strengths": ["coherent summary writing", "conflicting source reconciliation", "executive summaries", "structured reports"],
          "best_for": ["synthesise these findings", "write a summary of", "combine these sources", "create a report on"],
          "avoid_for": ["source retrieval", "fact-checking"]
        },
        "CitationTracker": {
          "role": "Academic citation and reference management",
          "strengths": ["paper citation networks", "reference formatting", "source lineage tracking", "academic database search"],
          "best_for": ["find citations for", "academic papers on", "who cited this", "bibliography for"],
          "avoid_for": ["general web research", "synthesis"]
        }
      },
      "tools": ["web_search", "arxiv_api", "semantic_scholar", "news_api", "wikipedia_api"],
      "common_metrics": ["source_count", "credibility_score", "coverage_breadth", "recency_score"],
      "best_practices": [
        "Define the research question before searching",
        "Use at least 3 independent sources for any claim",
        "Check publication date — older than 3 years may be outdated in fast-moving fields",
        "Distinguish primary sources (raw data, original papers) from secondary (reviews, summaries)",
        "Note what the sources do NOT cover — gaps are as informative as findings"
      ]
    },
    "trading": {
