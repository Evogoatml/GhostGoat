          "best_for": ["risk management", "position sizing", "how much to risk", "portfolio risk", "stop loss"],
          "avoid_for": ["entry signal generation", "on-chain analysis"]
        },
        "OnChainSentry": {
          "role": "Blockchain and DeFi on-chain metric analyst",
