      "common_metrics": ["mae", "rmse", "r2_score", "f1_score", "auc_roc", "precision", "recall"],
      "best_practices": [
        "Always inspect raw data before processing",
        "Correlation is not causation — establish mechanism before claiming cause",
        "Validate model on held-out data — never evaluate on training data",
        "Report confidence intervals, not just point estimates",
        "Visualise distributions — aggregate statistics hide shape",
        "Document data provenance — where did this data come from and when?"
      ]
    },
    "planning": {
